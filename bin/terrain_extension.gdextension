[configuration]
entry_symbol = "terrain_extension_init"
compatibility_minimum = "4.4"

[libraries]
windows.debug.x86_64 = "res://bin/libterrain_extension.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libterrain_extension.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/libterrain_extension.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libterrain_extension.linux.template_release.x86_64.so"
macos.debug = "res://bin/libterrain_extension.macos.template_debug.framework"
macos.release = "res://bin/libterrain_extension.macos.template_release.framework"

