class_name MeleeAttackContext
extends RefCounted

## Runtime attack packet compiled by MeleeDeckEvaluator from slotted technique cards.
## Dictates all visual, temporal, physical, and hitbox properties of an attack execution.

# --- Attack Execution Timing (Card-Driven) ---
## How fast the slash sweeps through space (seconds).
## Governs ProceduralSlashEffect tween and the duration the floating sword remains hidden.
var execution_duration: float = 0.24

## How frequent attacks can occur (seconds).
## Governs the cooldown before the next slotted technique in sequence can be cast.
var recovery_delay: float = 0.18

# --- Hitbox & Damage ---
var damage: float = 0.0
var poise_damage: float = 0.0
var knockback_force: float = 5.0
var stamina_cost: float = 10.0

# --- Kinetic Energy & Physics Metrics ---
## Participating physical mass in kilograms (derived from weapon voxel structure * modifiers).
var mass: float = 14.0

## Effective linear/tangential tip velocity (m/s) at the outer edge of the strike.
var tip_velocity: float = 0.0

## Rotational angular velocity in radians per second.
var angular_velocity: float = 0.0

## Linear velocity contributed by forward player lunge (m/s).
var lunge_velocity: float = 0.0

## Retained/inherited velocity from previous combo attacks (m/s).
var inherited_velocity: float = 0.0

## Kinetic energy generated by the strike in Joules: E = 0.5 * m * v^2.
var kinetic_energy: float = 0.0

## Linear/angular momentum generated by the strike in kg*m/s: p = m * v.
var momentum: float = 0.0

## Efficiency ratio of kinetic energy transfer into impact damage (default 1.0).
var kinetic_efficiency: float = 1.0

## Multiplier on effective mass participating in this specific strike.
var mass_multiplier: float = 1.0

## Velocity retention factor from previous attack (0.0 to 1.0+).
var momentum_retention: float = 0.0

## General damage & poise multipliers from modifiers.
var damage_multiplier: float = 1.0
var poise_multiplier: float = 1.0

# --- 3D Volumetric Slash VFX Mesh Parameters ---
var inner_radius: float = 0.75
var outer_radius: float = 2.45
var arc_sweep_degrees: float = 135.0
var volume_thickness: float = 0.22
var outer_height: float = 0.025
var tilt_degrees: float = -10.0
var is_reversed_sweep: bool = false

# --- Slash Energy Shader & Particle Colors ---
var core_color: Color = Color(0.9, 0.96, 1.0, 1.0)
var edge_color: Color = Color(0.15, 0.75, 1.0, 1.0)
var deep_color: Color = Color(0.02, 0.18, 0.75, 1.0)
var emission_intensity: float = 4.5
var trail_dissolve_rate: float = 0.65

# --- Kinematic Impulses ---
var player_lunge_distance: float = 0.0

# --- Trigger Payloads ---
var nested_triggers: Array = []

# --- Metadata ---
var source_card_id: String = ""

## Calculates all physical quantities: angular velocity, lunge speed, tip velocity,
## kinetic energy (E = 0.5 * m * v^2), and linear momentum (p = m * v).
func compute_kinetic_metrics(weapon_mass: float = 14.0) -> void:
	mass = maxf(weapon_mass * mass_multiplier, 0.1)
	var dur = maxf(execution_duration, 0.001)
	var arc_rad = deg_to_rad(arc_sweep_degrees)
	angular_velocity = arc_rad / dur
	var rot_speed = outer_radius * angular_velocity
	lunge_velocity = player_lunge_distance / dur
	tip_velocity = rot_speed + lunge_velocity + inherited_velocity
	kinetic_energy = 0.5 * mass * (tip_velocity * tip_velocity)
	momentum = mass * tip_velocity

func duplicate_context() -> RefCounted:
	var c = (load("res://src/combat/core/melee_attack_context.gd") as GDScript).new()
	c.execution_duration = execution_duration
	c.recovery_delay = recovery_delay
	c.damage = damage
	c.poise_damage = poise_damage
	c.knockback_force = knockback_force
	c.stamina_cost = stamina_cost
	c.mass = mass
	c.tip_velocity = tip_velocity
	c.angular_velocity = angular_velocity
	c.lunge_velocity = lunge_velocity
	c.inherited_velocity = inherited_velocity
	c.kinetic_energy = kinetic_energy
	c.momentum = momentum
	c.kinetic_efficiency = kinetic_efficiency
	c.mass_multiplier = mass_multiplier
	c.momentum_retention = momentum_retention
	c.damage_multiplier = damage_multiplier
	c.poise_multiplier = poise_multiplier
	c.inner_radius = inner_radius
	c.outer_radius = outer_radius
	c.arc_sweep_degrees = arc_sweep_degrees
	c.volume_thickness = volume_thickness
	c.outer_height = outer_height
	c.tilt_degrees = tilt_degrees
	c.is_reversed_sweep = is_reversed_sweep
	c.core_color = core_color
	c.edge_color = edge_color
	c.deep_color = deep_color
	c.emission_intensity = emission_intensity
	c.trail_dissolve_rate = trail_dissolve_rate
	c.player_lunge_distance = player_lunge_distance
	c.nested_triggers = nested_triggers.duplicate()
	c.source_card_id = source_card_id
	return c
