class_name AsciiGlyphRasterizer
extends RefCounted

## Pure utility responsible for rasterizing 1-bit glyph bitmasks for character codes.
## Operates 100% headlessly with zero dependency on OS display server or external TTF fonts.

static var _GLYPH_TABLE: Dictionary = {}

static func _static_init() -> void:
	_init_glyph_table()

static func rasterize_glyph_8x8(char_code: int) -> PackedByteArray:
	if _GLYPH_TABLE.is_empty():
		_init_glyph_table()

	var rows = _GLYPH_TABLE.get(char_code, null)
	if rows == null:
		rows = _generate_fallback_glyph(char_code)

	var mask = PackedByteArray()
	mask.resize(64)
	for y in range(8):
		var row_byte: int = rows[y]
		for x in range(8):
			var bit = (row_byte >> (7 - x)) & 1
			mask[x + y * 8] = bit
	return mask

static func _generate_fallback_glyph(char_code: int) -> Array[int]:
	# Default fallback: 1-pixel hollow border box for unknown characters
	if char_code == 0 or char_code == 32:
		return [0, 0, 0, 0, 0, 0, 0, 0]
	return [0x7e, 0x42, 0x42, 0x42, 0x42, 0x42, 0x7e, 0]

static func _init_glyph_table() -> void:
	# Space
	_GLYPH_TABLE[32] = [0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]
	# Exclamation !
	_GLYPH_TABLE[33] = [0x18, 0x18, 0x18, 0x18, 0x18, 0x00, 0x18, 0x00]
	# Double quote "
	_GLYPH_TABLE[34] = [0x66, 0x66, 0x66, 0x00, 0x00, 0x00, 0x00, 0x00]
	# Hash #
	_GLYPH_TABLE[35] = [0x24, 0x24, 0x7e, 0x24, 0x7e, 0x24, 0x24, 0x00]
	# Dollar $
	_GLYPH_TABLE[36] = [0x10, 0x3c, 0x50, 0x38, 0x14, 0x78, 0x10, 0x00]
	# Percent %
	_GLYPH_TABLE[37] = [0x62, 0x64, 0x08, 0x10, 0x26, 0x46, 0x00, 0x00]
	# Ampersand &
	_GLYPH_TABLE[38] = [0x30, 0x48, 0x30, 0x54, 0x4a, 0x34, 0x00, 0x00]
	# Single quote '
	_GLYPH_TABLE[39] = [0x18, 0x18, 0x08, 0x00, 0x00, 0x00, 0x00, 0x00]
	# Parens ( )
	_GLYPH_TABLE[40] = [0x0c, 0x18, 0x30, 0x30, 0x30, 0x18, 0x0c, 0x00]
	_GLYPH_TABLE[41] = [0x30, 0x18, 0x0c, 0x0c, 0x0c, 0x18, 0x30, 0x00]
	# Asterisk *
	_GLYPH_TABLE[42] = [0x00, 0x24, 0x18, 0x7e, 0x18, 0x24, 0x00, 0x00]
	# Plus +
	_GLYPH_TABLE[43] = [0x00, 0x18, 0x18, 0x7e, 0x18, 0x18, 0x00, 0x00]
	# Comma ,
	_GLYPH_TABLE[44] = [0x00, 0x00, 0x00, 0x00, 0x00, 0x18, 0x18, 0x08]
	# Minus / dash -
	_GLYPH_TABLE[45] = [0x00, 0x00, 0x00, 0x7e, 0x00, 0x00, 0x00, 0x00]
	# Period .
	_GLYPH_TABLE[46] = [0x00, 0x00, 0x00, 0x00, 0x00, 0x18, 0x18, 0x00]
	# Slash /
	_GLYPH_TABLE[47] = [0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x00]
	# Colon :
