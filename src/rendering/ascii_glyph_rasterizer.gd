	# Semicolon ;
	_GLYPH_TABLE[59] = [0x00, 0x18, 0x18, 0x00, 0x18, 0x18, 0x08, 0x10]
	# Chevrons < = >
	_GLYPH_TABLE[60] = [0x0c, 0x18, 0x30, 0x60, 0x30, 0x18, 0x0c, 0x00]
	_GLYPH_TABLE[61] = [0x00, 0x7e, 0x00, 0x7e, 0x00, 0x00, 0x00, 0x00]
	_GLYPH_TABLE[62] = [0x30, 0x18, 0x0c, 0x06, 0x0c, 0x18, 0x30, 0x00]
	# Question ?
	_GLYPH_TABLE[63] = [0x3c, 0x42, 0x04, 0x08, 0x10, 0x00, 0x10, 0x00]
	# At @
	_GLYPH_TABLE[64] = [0x3c, 0x42, 0x9a, 0xaa, 0x9e, 0x40, 0x3c, 0x00]
	# Brackets [ \ ] ^ _
	_GLYPH_TABLE[91] = [0x3c, 0x30, 0x30, 0x30, 0x30, 0x30, 0x3c, 0x00]
	_GLYPH_TABLE[92] = [0x80, 0x40, 0x20, 0x10, 0x08, 0x04, 0x02, 0x00]
	_GLYPH_TABLE[93] = [0x3c, 0x0c, 0x0c, 0x0c, 0x0c, 0x0c, 0x3c, 0x00]
	_GLYPH_TABLE[94] = [0x18, 0x24, 0x42, 0x00, 0x00, 0x00, 0x00, 0x00]
	_GLYPH_TABLE[95] = [0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0xff, 0x00]
	# Pipe | and tilde ~
	_GLYPH_TABLE[124] = [0x18, 0x18, 0x18, 0x18, 0x18, 0x18, 0x18, 0x18]
	_GLYPH_TABLE[126] = [0x00, 0x32, 0x4c, 0x00, 0x00, 0x00, 0x00, 0x00]
	# Uppercase Letters (selected common structural glyphs: X, I, H, M, O)
	_GLYPH_TABLE[73]  = [0x3c, 0x18, 0x18, 0x18, 0x18, 0x18, 0x3c, 0x00] # I
	_GLYPH_TABLE[72]  = [0x66, 0x66, 0x66, 0x7e, 0x66, 0x66, 0x66, 0x00] # H
