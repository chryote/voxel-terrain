	# Number 8
	_GLYPH_TABLE[56]  = [0x3c, 0x66, 0x66, 0x3c, 0x66, 0x66, 0x3c, 0x00]
	# Diamond / Crystal
	_GLYPH_TABLE[4]   = [0x18, 0x3c, 0x7e, 0xff, 0x7e, 0x3c, 0x18, 0x00]
