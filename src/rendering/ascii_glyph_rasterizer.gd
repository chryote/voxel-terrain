	# Lowercase letters (x, o, v)
	_GLYPH_TABLE[111] = [0x00, 0x00, 0x3c, 0x66, 0x66, 0x66, 0x3c, 0x00] # o
	_GLYPH_TABLE[118] = [0x00, 0x00, 0x66, 0x66, 0x66, 0x3c, 0x18, 0x00] # v
